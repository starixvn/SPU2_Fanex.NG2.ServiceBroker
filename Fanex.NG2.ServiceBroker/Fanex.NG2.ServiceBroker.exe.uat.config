<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="ONEbook.NG2.API" type="ONEbook.NG2.API.Configuration.NG2Configuration, ONEbook.NG2.API" />
    <section name="LogsConfiguration" type="Fanex.Module.Logs.Mappings.LogsConfiguration, Fanex.Module.Logs" />
    <section name="ONEbook.UM.ThirdParty" type="ONEbook.UM.ThirdParty.Configurations.UMClientConfiguration, ONEbook.UM.ThirdParty" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>
  <ONEbook.NG2.API configSource="ONEbook.NG2.API.config" />
  <LogsConfiguration configSource="LogsConfiguration.config" />
  <ONEbook.UM.ThirdParty ServiceUris="http://10.40.40.16:8887/api" EnableCheckUM="true" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" UMPageUrl="~/">
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="23:59" />
    </Products>
  </ONEbook.UM.ThirdParty>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <appSettings>
    <add key="MaxRetryCount" value="5" />
  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.73/msmq/Private$/entlib" defaultCategory="NG2ServiceBroker" />
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="APILoggerSpNames.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings configSource="ConnectionString.config" />
</configuration>